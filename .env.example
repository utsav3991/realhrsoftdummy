DEBUG=true
SECRET_KEY=dev-only-change-me
# Token issuer; the Marketplace's REALHRSOFT_ISSUER must equal it.
ISSUER=http://localhost:8100
# Marketplace backend, without /api.
MARKETPLACE_URL=http://localhost:8000
MARKETPLACE_AUDIENCE=realhrsoft-marketplace
MARKETPLACE_SYNC_AUDIENCE=realhrsoft-marketplace-sync
# Shared with the Marketplace's REALHRSOFT_API_TOKEN (reconciliation reads).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SNAPSHOT_API_TOKEN=
SYNC_DELIVER_ON_COMMIT=true
# DATABASE_URL=sqlite:///db.sqlite3
# Docker or a deployed domain: hosts Django answers to, and the browser origin(s)
# allowed to post the login and admin forms.
# ALLOWED_HOSTS=localhost,127.0.0.1,realhrsoft.example.com
# CSRF_TRUSTED_ORIGINS=https://realhrsoft.example.com
